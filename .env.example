# Server
PORT=5050
MONGO_URI=mongodb://localhost:27017/portfolio

# Admin session length.
JWT_EXPIRES_IN=7d

# Optional. If unset, a random signing key is generated in memory on every
# server start, so admin logins reset whenever the process restarts (fine for
# local dev). On hosting platforms that restart/recycle the process often
# (cold starts, deploys, free-tier idle spin-down), set a fixed random value
# here instead so admin sessions survive those restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Admin credentials — only used the first time you run the seed script to
# create the admin user. After that, change them from the admin panel's
# Account tab; editing these values here does nothing on their own.
ADMIN_EMAIL=riiju@admin.com
ADMIN_PASSWORD=your_secure_password

# Client
VITE_API_BASE_URL=http://localhost:5050/api
